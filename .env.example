# OpenAI-compatible endpoint. Change BASE_URL only if your provider requires it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
# Language-model tasks are locked to this model in code.
OPENAI_MODEL=gpt-6.1-sol

# Local server
PORT=8787
HOST=127.0.0.1

# Session storage (relative to project root or absolute)
SESSIONS_DIR=./data/sessions
PROJECTS_DIR=./data/projects

# Legacy default for direct streamChat helpers; Agent profiles override this value.
# REASONING_EFFORT=medium
# Agent profiles control reasoning effort. For endpoints that reject this parameter:
REASONING_SUPPORTED=true
# Fill in the model service's actual context window. Blank = unknown.
CONTEXT_WINDOW_TOKENS=
# Optional service-confirmed tokenizer: o200k_base or cl100k_base.
TOKENIZER_ENCODING=
AUTOMATIC_MEMORY=true

# Paper library: original PDF/assets + SQLite metadata and FTS5 index.
PAPERS_DIR=./data/papers
# Defaults to .venv-papers/bin/python, installed with npm run setup:papers.
# PAPER_PYTHON=

# System prompt: 'sections' (default) assembles the sectioned prompt;
# 'off' sends only the conversation history, no system message at all.
SYSTEM_PROMPT=sections
